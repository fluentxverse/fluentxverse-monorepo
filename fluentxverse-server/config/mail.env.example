# Native dashboard mail. No mailbox is enabled until this is configured.
# Use your deployment secret store for passwords, not VITE_* variables.
MAIL_SUPPORT_PASSWORD=replace-with-provider-app-password
MAIL_ACCOUNTS_JSON='[{"id":"support","label":"FluentXVerse Support","address":"support@fluentxverse.com","adminIds":[],"imap":{"host":"imap.provider.example","port":993,"user":"support@fluentxverse.com","passwordEnv":"MAIL_SUPPORT_PASSWORD"},"smtp":{"host":"smtp.provider.example","port":465,"secure":true,"user":"support@fluentxverse.com","passwordEnv":"MAIL_SUPPORT_PASSWORD"}}]'

# SMTP with STARTTLS: use port 587 and secure:false. TLS remains mandatory.
# IMAP uses implicit TLS (normally 993), with certificate verification enabled.
# adminIds are the only existing Admin IDs granted access to a private mailbox.
# There is no superadmin bypass. Set shared:true only for team mailboxes.
# An optional sentFolder overrides the provider's IMAP special-use Sent folder.
