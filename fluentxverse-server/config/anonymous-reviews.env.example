# Isolated, opt-in Horizen testnet pilot. No transactions occur just by starting the app.
ANONYMOUS_REVIEWS_ENABLED=false
PRIVACY_INFRA_MODE=bridge_only
ANONYMOUS_REVIEWS_CHAIN_ID=2651420
ANONYMOUS_REVIEWS_RPC_URL=https://horizen-testnet.rpc.caldera.xyz/http
ANONYMOUS_REVIEWS_CONTRACT=
ANONYMOUS_REVIEWS_BRIDGE=0x3098A6974649478f0133046e44105AA84e868C21
ANONYMOUS_REVIEWS_DOMAIN_ID=175
ANONYMOUS_REVIEWS_ZKVERIFY_VK_HASH=
ANONYMOUS_REVIEWS_VK_SHA256=
ANONYMOUS_REVIEWS_WASM_SHA256=
ANONYMOUS_REVIEWS_ZKEY_SHA256=
# Dedicated 32-byte AES key in hex, not a JWT, issuer or screening key.
ANONYMOUS_REVIEWS_ENCRYPTION_KEY=
# Dedicated proof-only Engine project: pinned VK/domain and no contract writes.
GMR_ANONYMOUS_REVIEWS_ENGINE_API_BASE=
GMR_ANONYMOUS_REVIEWS_ENGINE_API_KEY=

# Separate opt-in tally upgrade. Never relabel historical platform-calculated batches.
ANONYMOUS_REVIEW_TALLY_ENABLED=false
ANONYMOUS_REVIEW_TALLY_MAX_REVIEWS=8
ANONYMOUS_REVIEWS_DEPLOYMENT_BLOCK=
ANONYMOUS_REVIEW_TALLY_IMAGE_ID=
# Absolute path to an approved, locally built RISC Zero 2.3.2 host binary.
ANONYMOUS_REVIEW_TALLY_PROVER=
ANONYMOUS_REVIEW_TALLY_PROVER_SHA256=
# Production sidecar, reachable only over the local Docker network (no public port).
ANONYMOUS_REVIEW_TALLY_PROVER_URL=http://review-tally-prover:8092
ANONYMOUS_REVIEW_TALLY_PROVER_TOKEN=
# A new restricted project for Risc0/V2_3; do not use the Groth16-only review key.
GMR_ANONYMOUS_TALLY_ENGINE_API_BASE=
GMR_ANONYMOUS_TALLY_ENGINE_API_KEY=
