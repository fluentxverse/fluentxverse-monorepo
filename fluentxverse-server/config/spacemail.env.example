# Spacemail (Spaceship): https://www.spaceship.com/knowledgebase/connect-spacemail-to-email-client/
# API server only. Replace the address with your actual mailbox in both logins.
# Use the mailbox password, not your Spaceship account password.
# Never commit a populated copy or use VITE_* for these variables.
MAIL_SPACEMAIL_PASSWORD=replace-with-mailbox-password
MAIL_ACCOUNTS_JSON='[{"id":"spacemail","label":"FluentXVerse","address":"your-mailbox@fluentxverse.com","adminIds":[],"imap":{"host":"mail.spacemail.com","port":993,"user":"your-mailbox@fluentxverse.com","passwordEnv":"MAIL_SPACEMAIL_PASSWORD"},"smtp":{"host":"mail.spacemail.com","port":465,"secure":true,"user":"your-mailbox@fluentxverse.com","passwordEnv":"MAIL_SPACEMAIL_PASSWORD"}}]'

# adminIds: existing administrator IDs allowed access. No superadmin bypass.
# Set shared:true only for the support mailbox shared by all administrators.
# Leave sentFolder unset so the client discovers the provider's Sent folder.
# Ensure IMAP/SMTP access is enabled for the mailbox in Spacemail settings.
