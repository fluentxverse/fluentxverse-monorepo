# V2 is opt-in and independent from legacy certification / booking eligibility.
SCREENING_ENABLED=false
PRIVACY_INFRA_MODE=bridge_only
SCREENING_RPC_URL=https://mainnet.base.org
SCREENING_ARTIFACTS_APPROVED=false
# Explicitly choose self-operated for an internally reviewed setup. This is not an audit.
SCREENING_RELEASE_POLICY=independent-reviewed
GMR_SCREENING_ENGINE_API_BASE=http://host.docker.internal:8090
GMR_SCREENING_ENGINE_API_KEY=
SCREENING_CHAIN_ID=8453
# No ERC-8004 registry or custom validator. The existing circuit binds agent ID zero
# and the official receipt bridge; old validator-bound credentials are not reused.
SCREENING_RECEIPT_BRIDGE=0xCb47A3C3B9Eb2E549a3F2EA4729De28CafbB2b69

# Dedicated server secrets. Never use JWT_SECRET or expose these in a VITE variable.
SCREENING_ISSUER_KEY_HEX=
SCREENING_EVIDENCE_KEY_HEX=
SCREENING_EVIDENCE_DIR=/private-screening-evidence
SCREENING_ISSUER_HASH=
SCREENING_ZKVERIFY_DOMAIN_ID=2
SCREENING_ZKVERIFY_VK_HASH=

# Proving artifacts and cryptographic setup verification live in GMR Engine.
# Pin its exact release manifest and assurance policy. No local prover fallback.
SCREENING_RELEASE_MANIFEST_SHA256=
