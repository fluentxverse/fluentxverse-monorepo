pragma circom 2.1.6;
include "poseidon.circom";
include "eddsaposeidon.circom";

template Screening() {
  signal input writtenScore;
  signal input speakingScore;
  signal input profileApproved;
  signal input interviewPassed;
  signal input credentialNonce;
  signal input signatureR8x;
  signal input signatureR8y;
  signal input signatureS;
  signal input credentialCommitment;
  signal input policyHash;
  signal input schemaHash;
  signal input issuerHash;
  signal input issuerAx;
  signal input issuerAy;
  signal input evidenceRoot;
  signal input attemptHash;
  signal input issuedAt;
  signal input expiresAt;
  signal input chainId;
  signal input agentId;
  signal input adapterAddress;
  signal input subjectHash;
  signal output valid;

  component writtenBits = Num2Bits(7);
  component speakingBits = Num2Bits(7);
  writtenBits.in <== writtenScore;
  speakingBits.in <== speakingScore;
  component writtenMin = LessThan(7);
  component writtenMax = LessThan(7);
  component speakingMin = LessThan(7);
  component speakingMax = LessThan(7);
  writtenMin.in[0] <== writtenScore; writtenMin.in[1] <== 90; writtenMin.out === 0;
  writtenMax.in[0] <== writtenScore; writtenMax.in[1] <== 101; writtenMax.out === 1;
  speakingMin.in[0] <== speakingScore; speakingMin.in[1] <== 85; speakingMin.out === 0;
  speakingMax.in[0] <== speakingScore; speakingMax.in[1] <== 101; speakingMax.out === 1;
  profileApproved === 1;
  interviewPassed === 1;
  component issuedBits = Num2Bits(64); issuedBits.in <== issuedAt;
  component expiryBits = Num2Bits(64); expiryBits.in <== expiresAt;
  component chainBits = Num2Bits(64); chainBits.in <== chainId;
  component agentBits = Num2Bits(64); agentBits.in <== agentId;
  component adapterBits = Num2Bits(160); adapterBits.in <== adapterAddress;
  expiresAt === issuedAt + 31536000;

  component commitment = Poseidon(4);
  commitment.inputs[0] <== subjectHash; commitment.inputs[1] <== credentialNonce;
  commitment.inputs[2] <== policyHash; commitment.inputs[3] <== attemptHash;
  credentialCommitment === commitment.out;
  component issuer = Poseidon(2);
  issuer.inputs[0] <== issuerAx; issuer.inputs[1] <== issuerAy;
  issuerHash === issuer.out;
  component message = Poseidon(15);
  message.inputs[0] <== writtenScore; message.inputs[1] <== speakingScore;
  message.inputs[2] <== profileApproved; message.inputs[3] <== interviewPassed;
  message.inputs[4] <== credentialCommitment; message.inputs[5] <== policyHash;
  message.inputs[6] <== schemaHash; message.inputs[7] <== issuerHash;
  message.inputs[8] <== evidenceRoot; message.inputs[9] <== attemptHash;
  message.inputs[10] <== issuedAt; message.inputs[11] <== expiresAt;
  message.inputs[12] <== chainId; message.inputs[13] <== agentId;
  message.inputs[14] <== adapterAddress;
  component signature = EdDSAPoseidonVerifier();
  signature.enabled <== 1;
  signature.Ax <== issuerAx; signature.Ay <== issuerAy;
  signature.R8x <== signatureR8x; signature.R8y <== signatureR8y;
  signature.S <== signatureS; signature.M <== message.out;
  valid <== 1;
}
component main { public [credentialCommitment, policyHash, schemaHash, issuerHash, issuerAx, issuerAy, evidenceRoot, attemptHash, issuedAt, expiresAt, chainId, agentId, adapterAddress, subjectHash] } = Screening();
