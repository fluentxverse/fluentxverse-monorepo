[Unit]
Description=FluentXverse Webhook Server
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
# UPDATE THESE VALUES for your system:
User=paulanthonyarriola
WorkingDirectory=/home/paulanthonyarriola/Desktop/fluentxverse/fluentxverse-server
ExecStart=/home/paulanthonyarriola/.bun/bin/bun run scripts/webhook-server.ts
Restart=always
RestartSec=10
StandardOutput=append:/home/paulanthonyarriola/webhook.log
StandardError=append:/home/paulanthonyarriola/webhook.log

# Environment variables - SET YOUR ACTUAL GITHUB WEBHOOK SECRET HERE
Environment=WEBHOOK_SECRET=${WEBHOOK_SECRET}
Environment=PATH=/home/paulanthonyarriola/.bun/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
