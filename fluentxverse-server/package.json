    "@mastra/core": "^0.24.9",
    "@sinclair/typebox": "^0.34.46",
    "@types/node": "^24.10.4",
    "bcrypt-ts": "^7.1.0",
    "elysia": "^1.4.19",
    "nanoid": "^5.1.6",
    "neo4j-driver": "^6.0.1",
    "pg": "^8.16.3",
