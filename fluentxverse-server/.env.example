# ===========================================
# FluentXverse Server Environment Variables
# Copy this to .env and fill in your values
# ===========================================

# ---- Server ----
NODE_ENV=production
ALLOW_MOCK_TICKET_PURCHASES=false
API_PORT=8765
SOCKET_PORT=8767
TUTOR_PORT=5173
STUDENT_PORT=5174
DASHBOARD_PORT=5175

# ---- PostgreSQL ----
POSTGRES_DB=fluentxverse
POSTGRES_USER=fluentxverse_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_PORT=5432

# ---- Memgraph ----
MEMGRAPH_USER=fluentxverse
MEMGRAPH_PASSWORD=CHANGE_ME_MEMGRAPH_PASSWORD
MEMGRAPH_HTTP_PORT=7444
MEMGRAPH_BOLT_PORT=7687

# ---- Redis ----
REDIS_PORT=6379
REDIS_AOF=yes

# ---- SeaweedFS ----
SEAWEED_MASTER_PORT=9333
SEAWEED_VOLUME_ADMIN_PORT=8080
SEAWEED_VOLUME_PUBLIC_PORT=8081
SEAWEED_FILER_PORT=8888
SEAWEED_S3_PORT=8333
SEAWEED_MAX_VOLUMES=5

# ---- JWT / Auth ----
JWT_SECRET=CHANGE_ME_SUPER_SECRET_JWT_KEY_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_SECRET_FOR_REFRESH_TOKEN
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# ---- CORS / Frontend URLs (comma-separated for multiple) ----
FRONTEND_URLS=https://student.yourdomain.com,https://tutor.yourdomain.com,https://dashboard.yourdomain.com

# ---- Notification ----
NOTIFICATION_RETENTION_DAYS=30

# ---- WebRTC TURN relay (required for calls on restrictive networks) ----
# Use a TURN server configured with shared-secret authentication (coturn: use-auth-secret).
# Example: turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_URLS=
TURN_SHARED_SECRET=

# ---- GMR Engine / Web3 (REQUIRED for managed wallets and ticket transfers) ----
GMR_ENGINE_API_BASE=http://localhost:8090
GMR_ENGINE_API_KEY=your_gmr_engine_api_key
VAULT_WALLET_ADDRESS=0xYourVaultWalletAddress

# ---- OpenAI (REQUIRED for speaking exam) ----
OPENAI_API_KEY=sk-your-openai-api-key

# ---- zk Tutor Certification (proof issuance) ----
TUTOR_CERT_ISSUER_ID=fluentxverse:tutor-certification:v1
TUTOR_CERT_ISSUER_SECRET=CHANGE_ME_TUTOR_CERT_ISSUER_SECRET
STUDENT_LESSON_ISSUER_SECRET=CHANGE_ME_STUDENT_LESSON_ISSUER_SECRET
TUTOR_CERT_COMMITMENT_SALT=CHANGE_ME_TUTOR_CERT_COMMITMENT_SALT
ZKVERIFY_SEED_PHRASE=your zkVerify Volta seed phrase
ZKVERIFY_DOMAIN_ID=0
ZKVERIFY_ENABLED=true

# ---- Ticket Contract (optional) ----
TICKET_CONTRACT_ADDRESS=0x6fB1BbF7929AF18Dbd6f4F15b03307d067E838db
TICKET_CHAIN_ID=421614
TICKET_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
TICKET_BASIC_TOKEN_ID=
TICKET_PREMIUM_TOKEN_ID=
TICKET_TRIAL_TOKEN_ID=
