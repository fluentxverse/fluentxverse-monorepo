# ===========================================
# FluentXverse Server Environment Variables
# Copy this to .env and fill in your values
# ===========================================

# ---- Server ----
NODE_ENV=production
ALLOW_MOCK_TICKET_PURCHASES=false
API_PORT=8765
SOCKET_PORT=8767
TUTOR_PORT=5173
STUDENT_PORT=5174
DASHBOARD_PORT=5175

# ---- PostgreSQL ----
POSTGRES_DB=fluentxverse
POSTGRES_USER=fluentxverse_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_PORT=5432

# ---- Memgraph ----
MEMGRAPH_USER=fluentxverse
MEMGRAPH_PASSWORD=CHANGE_ME_MEMGRAPH_PASSWORD
MEMGRAPH_HTTP_PORT=7444
MEMGRAPH_BOLT_PORT=7687

# ---- Redis ----
REDIS_PORT=6379
REDIS_AOF=yes

# ---- SeaweedFS ----
SEAWEED_MASTER_PORT=9333
SEAWEED_VOLUME_ADMIN_PORT=8080
SEAWEED_VOLUME_PUBLIC_PORT=8081
SEAWEED_FILER_PORT=8888
SEAWEED_S3_PORT=8333
SEAWEED_MAX_VOLUMES=5

# ---- JWT / Auth ----
API_PUBLIC_URL=https://api.fluentxverse.com
ADMIN_DASHBOARD_PUBLIC_URL=https://dashboard.fluentxverse.com
# Leave COOKIE_DOMAIN unset to keep session cookies on the API host only.
JWT_SECRET=CHANGE_ME_SUPER_SECRET_JWT_KEY_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_SECRET_FOR_REFRESH_TOKEN
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# ---- CORS / Frontend URLs (comma-separated for multiple) ----
FRONTEND_URLS=https://student.fluentxverse.com,https://tutor.fluentxverse.com,https://dashboard.fluentxverse.com,https://student.fluentxverse.xyz,https://tutor.fluentxverse.xyz,https://dashboard.fluentxverse.xyz

# ---- Notification ----
NOTIFICATION_RETENTION_DAYS=30

# ---- WebRTC TURN relay (required for calls on restrictive networks) ----
# Cloudflare requires a TURN Key ID, not a Realtime SFU App ID.
# Set TURN_PROVIDER=cloudflare after verifying the key. Keep the API token server-only.
# If TURN_PROVIDER is empty, Cloudflare is selected when its keys are present,
# otherwise coturn when TURN_URLS is set, otherwise STUN only.
TURN_PROVIDER=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_TTL_SECONDS=7200

# RealtimeKit media migration. Provider is pinned on first authorized room entry.
# Keep webrtc until both updated frontends and a controlled pilot are verified.
CLASSROOM_MEDIA_PROVIDER=realtimekit
QA_RECORDING_ENABLED=false
# Generate 32 random bytes as 64 hex characters. Back up securely; never rotate without migrating recordings.
QA_RECORDING_ENCRYPTION_KEY=
CLOUDFLARE_RTK_PILOT_BOOKING_IDS=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_RTK_APP_ID=
CLOUDFLARE_RTK_API_TOKEN=
CLOUDFLARE_RTK_STUDENT_PRESET=group_call_participant
CLOUDFLARE_RTK_TUTOR_PRESET=group_call_participant
# Alternative: TURN_PROVIDER=coturn with shared-secret authentication (use-auth-secret).
# Example: turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_URLS=
TURN_SHARED_SECRET=

# ---- GMR Engine / Web3 (REQUIRED for managed wallets and ticket transfers) ----
GMR_ENGINE_API_BASE=http://localhost:8090
GMR_ENGINE_API_KEY=your_gmr_engine_api_key
VAULT_WALLET_ADDRESS=0xYourVaultWalletAddress

# ---- OpenAI (REQUIRED for speaking exam) ----
OPENAI_API_KEY=sk-your-openai-api-key

# ---- zk Tutor Certification (proof issuance) ----
TUTOR_CERT_ISSUER_ID=fluentxverse:tutor-certification:v1
TUTOR_CERT_ISSUER_SECRET=CHANGE_ME_TUTOR_CERT_ISSUER_SECRET
STUDENT_LESSON_ISSUER_SECRET=CHANGE_ME_STUDENT_LESSON_ISSUER_SECRET
TUTOR_CERT_COMMITMENT_SALT=CHANGE_ME_TUTOR_CERT_COMMITMENT_SALT
ZKVERIFY_SEED_PHRASE=your zkVerify Volta seed phrase
ZKVERIFY_DOMAIN_ID=0
ZKVERIFY_ENABLED=true

# ---- Ticket Contract (optional) ----
# Deploy an ERC-1155 ticket contract on this chain before enabling on-chain tickets.
TICKET_CONTRACT_ADDRESS=
TICKET_CHAIN_ID=84532
# RPC credentials live in GMR Engine, not the app/browser environment.
TICKET_BASIC_TOKEN_ID=
TICKET_PREMIUM_TOKEN_ID=
TICKET_TRIAL_TOKEN_ID=
