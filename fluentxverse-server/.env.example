# ===========================================
# FluentXverse Server Environment Variables
# Copy this to .env and fill in your values
# ===========================================

# ---- Server ----
NODE_ENV=production
API_PORT=8765
SOCKET_PORT=8767

# ---- PostgreSQL ----
POSTGRES_DB=fluentxverse
POSTGRES_USER=fluentxverse_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_PORT=5432

# ---- Memgraph ----
MEMGRAPH_USER=fluentxverse
MEMGRAPH_PASSWORD=CHANGE_ME_MEMGRAPH_PASSWORD
MEMGRAPH_HTTP_PORT=7444
MEMGRAPH_BOLT_PORT=7687

# ---- Redis ----
REDIS_PORT=6379
REDIS_AOF=yes

# ---- SeaweedFS ----
SEAWEED_MASTER_PORT=9333
SEAWEED_VOLUME_ADMIN_PORT=8080
SEAWEED_VOLUME_PUBLIC_PORT=8081
SEAWEED_FILER_PORT=8888
SEAWEED_S3_PORT=8333
SEAWEED_MAX_VOLUMES=5

# ---- JWT / Auth ----
JWT_SECRET=CHANGE_ME_SUPER_SECRET_JWT_KEY_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_SECRET_FOR_REFRESH_TOKEN
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ---- CORS / Frontend URLs (comma-separated for multiple) ----
FRONTEND_URLS=https://student.yourdomain.com,https://tutor.yourdomain.com,https://dashboard.yourdomain.com

# ---- Notification ----
NOTIFICATION_RETENTION_DAYS=30

# ---- Thirdweb (REQUIRED) ----
THIRDWEB_SECRET_KEY=your_thirdweb_secret_key
THIRDWEB_CLIENT_ID=your_thirdweb_client_id
THIRDWEB_VAULT_WALLET_ADDRESS=0xYourVaultWalletAddress
THIRDWEB_VAULT_ACCESS_TOKEN=your_vault_access_token
THIRDWEB_VAULT_ADMIN_KEY=your_vault_admin_key

# ---- OpenAI (REQUIRED for speaking exam) ----
OPENAI_API_KEY=sk-your-openai-api-key

# ---- Ticket Contract (optional) ----
TICKET_CONTRACT_ADDRESS=0x6fB1BbF7929AF18Dbd6f4F15b03307d067E838db
TICKET_CHAIN_ID=421614
