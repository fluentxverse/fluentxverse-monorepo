# ===========================================
# FluentXverse Server Environment Variables
# Copy this to .env and fill in your values
# ===========================================

# ---- Server ----
NODE_ENV=production
PORT=8765
SOCKET_PORT=8767

# ---- PostgreSQL ----
POSTGRES_DB=fluentxverse
POSTGRES_USER=fluentxverse_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_PORT=5432
DATABASE_URL=postgres://fluentxverse_user:CHANGE_ME_STRONG_PASSWORD_HERE@localhost:5432/fluentxverse

# ---- Memgraph ----
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=fluentxverse
MEMGRAPH_PASSWORD=CHANGE_ME_MEMGRAPH_PASSWORD
MEMGRAPH_HTTP_PORT=7444
MEMGRAPH_BOLT_PORT=7687

# ---- Redis ----
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_AOF=yes

# ---- SeaweedFS ----
SEAWEED_MASTER_URL=http://localhost:9333
SEAWEED_FILER_URL=http://localhost:8888
SEAWEED_MASTER_PORT=9333
SEAWEED_VOLUME_ADMIN_PORT=8080
SEAWEED_VOLUME_PUBLIC_PORT=8081
SEAWEED_FILER_PORT=8888
SEAWEED_S3_PORT=8333
SEAWEED_MAX_VOLUMES=5

# ---- JWT / Auth ----
JWT_SECRET=CHANGE_ME_SUPER_SECRET_JWT_KEY_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_SECRET_FOR_REFRESH_TOKEN
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ---- CORS / Frontend URLs (comma-separated for multiple) ----
# These will be your Cloudflare Tunnel URLs once set up
FRONTEND_URLS=https://student.yourdomain.com,https://tutor.yourdomain.com,https://dashboard.yourdomain.com

# ---- Notification ----
NOTIFICATION_RETENTION_DAYS=30

# ---- Email (optional) ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ---- Cloudflare Tunnel (for reference) ----
# Your tunnel will expose:
# - API: https://api.yourdomain.com -> localhost:8765
# - WebSocket: https://ws.yourdomain.com -> localhost:8767
# - Files: https://files.yourdomain.com -> localhost:8888 (SeaweedFS filer)
