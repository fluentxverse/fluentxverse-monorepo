# Webhook server Dockerfile
FROM docker.io/oven/bun:1-alpine

WORKDIR /app

# Copy webhook server script and package.json
COPY package.json ./
COPY scripts/webhook-server.ts ./scripts/
COPY scripts/deploy.sh ./scripts/

# Install minimal dependencies (if any needed)
RUN bun install --production || true

# Make deploy script executable
RUN chmod +x scripts/deploy.sh

EXPOSE 9000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:9000/health || exit 1

CMD ["bun", "run", "scripts/webhook-server.ts"]
