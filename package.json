{
  "name": "fluentxverse-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "fluentxverse-tutor-solid-prototype",
    "fluentxverse-student-solid-prototype",
    "fluentxverse-server",
    "fluentxverse-dashboard",
    "fluentxverse-site"
  ],
  "scripts": {
    "dev:tutor": "npm --prefix fluentxverse-tutor-solid-prototype run dev",
    "dev:student": "npm --prefix fluentxverse-student-solid-prototype run dev",
    "dev:server": "cd fluentxverse-server && bun run dev",
    "dev:dashboard": "cd fluentxverse-dashboard && bun run dev",
    "dev:site": "cd fluentxverse-site && bun run dev",
    "dev:all": "concurrently \"bun run dev:server\" \"bun run dev:tutor\" \"bun run dev:student\" \"bun run dev:dashboard\"",
    "build:tutor": "npm --prefix fluentxverse-tutor-solid-prototype run build",
    "build:student": "npm --prefix fluentxverse-student-solid-prototype run build",
    "build:server": "cd fluentxverse-server && bunx tsc --noEmit",
    "build:dashboard": "cd fluentxverse-dashboard && bun run build",
    "build:site": "cd fluentxverse-site && bun run build",
    "build:all": "bun run build:server && bun run build:tutor && bun run build:student && bun run build:dashboard && bun run build:site",
    "install:all": "bun install && npm --prefix fluentxverse-tutor-solid-prototype ci --workspaces=false && npm --prefix fluentxverse-student-solid-prototype ci --workspaces=false",
    "deploy:student": "npm --prefix fluentxverse-student-solid-prototype run cf:deploy",
    "deploy:tutor": "npm --prefix fluentxverse-tutor-solid-prototype run cf:deploy"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
