{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "paths": { "@/*": ["./student/*"], "@client/*": ["./student/client/*"], "@components/*": ["./student/Components/*"], "@context/*": ["./student/context/*"] },
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "student", "entry.tsx", "vite.config.ts"]
}
