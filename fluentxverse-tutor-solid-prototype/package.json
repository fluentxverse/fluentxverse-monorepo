{
  "name": "fluentxverse-tutor-solid-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177 --strictPort",
    "dev:api": "bun run backend/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5177 --strictPort",
    "cf:deploy": "node ../scripts/release-apps.mjs --deploy=tutor",
    "cf:dry-run": "npm run build && bunx wrangler@4.149.0 deploy --dry-run",
    "test:production": "node tests/production-hosting.cjs",
    "test": "bun test tests/*.test.ts",
    "test:browser": "node tests/browser.cjs"
  },
  "dependencies": {
    "@cloudflare/realtimekit": "2.0.2",
    "@solidjs/router": "1.0.0",
    "axios": "^1.20.0",
    "lucide-solid": "1.55.0",
    "pdfjs-dist": "6.4.299",
    "socket.io-client": "^4.8.4",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "25.9.8",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vite-plugin-solid": "2.11.14"
  }
}
