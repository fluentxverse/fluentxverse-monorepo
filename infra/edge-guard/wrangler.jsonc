{
  "name": "fluentxverse-edge-guard",
  "account_id": "8355506b306aa26ed64113cdc82cf338",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "api.fluentxverse.com/ai/*", "zone_name": "fluentxverse.com" },
    { "pattern": "api.fluentxverse.com/proof/*", "zone_name": "fluentxverse.com" },
    { "pattern": "api.fluentxverse.com/screening/admin/*", "zone_name": "fluentxverse.com" },
    { "pattern": "api.fluentxverse.com/anonymous-reviews/admin/*", "zone_name": "fluentxverse.com" },
    { "pattern": "api.fluentxverse.com/anonymous-reviews/public/*", "zone_name": "fluentxverse.com" },
    { "pattern": "api.fluentxverse.com/lesson-passes/admin/*", "zone_name": "fluentxverse.com" },
    { "pattern": "api.fluentxverse.com/lesson-passes/public/*", "zone_name": "fluentxverse.com" },
    { "pattern": "api.fluentxverse.com/exam/speaking/*", "zone_name": "fluentxverse.com" },
    { "pattern": "api.fluentxverse.com/exam/written/*", "zone_name": "fluentxverse.com" },
    { "pattern": "api.fluentxverse.com/tutor/intro-video*", "zone_name": "fluentxverse.com" },
    { "pattern": "api.fluentxverse.com/tutor/profile-picture*", "zone_name": "fluentxverse.com" },
    { "pattern": "api.fluentxverse.com/interview/recording*", "zone_name": "fluentxverse.com" },
    { "pattern": "api.fluentxverse.com/auth/login*", "zone_name": "fluentxverse.com" },
    { "pattern": "api.fluentxverse.com/auth/register*", "zone_name": "fluentxverse.com" },
    { "pattern": "api.fluentxverse.com/tutor/login*", "zone_name": "fluentxverse.com" },
    { "pattern": "api.fluentxverse.com/tutor/register*", "zone_name": "fluentxverse.com" },
    { "pattern": "api.fluentxverse.com/admin/login*", "zone_name": "fluentxverse.com" },
    { "pattern": "api.fluentxverse.com/student/login*", "zone_name": "fluentxverse.com" },
    { "pattern": "api.fluentxverse.com/student/register*", "zone_name": "fluentxverse.com" },
    { "pattern": "api.fluentxverse.com/student/auth/*", "zone_name": "fluentxverse.com" }
  ],
  "ratelimits": [
    { "name": "GENERAL", "namespace_id": "24002401", "simple": { "limit": 3000, "period": 60 } },
    { "name": "AUTH", "namespace_id": "24002402", "simple": { "limit": 100, "period": 60 } },
    { "name": "UPLOAD", "namespace_id": "24002403", "simple": { "limit": 30, "period": 60 } },
    { "name": "COMPUTE", "namespace_id": "24002404", "simple": { "limit": 30, "period": 60 } },
    { "name": "PUBLIC_PROOF", "namespace_id": "24002405", "simple": { "limit": 60, "period": 60 } }
  ]
}
