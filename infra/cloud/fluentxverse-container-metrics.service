[Unit]
Description=FluentXVerse sanitized Docker statistics collector
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=fluentxverse-container-metrics
Group=fluentxverse-container-metrics
SupplementaryGroups=docker
StateDirectory=fluentxverse-container-metrics
StateDirectoryMode=0755
ExecStart=/usr/local/bin/fluentxverse-container-metrics
Restart=on-failure
RestartSec=5
Environment=GOMAXPROCS=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
UMask=0022
MemoryMax=64M
CPUQuota=5%
TasksMax=32

[Install]
WantedBy=multi-user.target
