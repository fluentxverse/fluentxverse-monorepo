[Unit]
Description=FluentXVerse host metrics collector
After=local-fs.target network.target

[Service]
Type=simple
User=fluentxverse-metrics
Group=fluentxverse-metrics
StateDirectory=fluentxverse-metrics
StateDirectoryMode=0755
ExecStart=/usr/local/bin/fluentxverse-host-metrics --interface ens3 --interval 5s --allowance-gib 2048
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
IPAddressDeny=any
CapabilityBoundingSet=
UMask=0022
MemoryMax=32M
CPUQuota=2%
TasksMax=16

[Install]
WantedBy=multi-user.target
