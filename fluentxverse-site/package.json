{
  "name": "fluentxverse-site",
  "version": "1.0.0",
  "description": "FluentXVerse - Static project/team site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run dev.ts --watch",
    "build": "bun run build.ts",
    "preview": "bun run build && cd dist && bunx serve",
    "deploy": "bun run build && bunx wrangler deploy"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@cloudflare/kv-asset-handler": "^0.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
