{
  "name": "fluentxverse-site",
  "version": "1.0.0",
  "description": "FluentXVerse - Corporate ecosystem website built with SolidJS",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "bun run build && bunx wrangler deploy"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-solid": "^2.11.14"
  },
  "dependencies": {
    "@cloudflare/kv-asset-handler": "^0.5.0",
    "@solidjs/router": "^1.0.0",
    "lucide-solid": "^1.54.0",
    "solid-js": "^1.9.17"
  }
}
